# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="file:./db.sqlite"

# Required on Vercel; provided by the Upstash Redis Marketplace integration.
# Leave both empty to use SQLite for local development.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Vercel reads family-tree:<VERCEL_ENV>:family:<instance>, default instance main.
FAMILY_INSTANCE_ID="main"
# Outside Vercel, read a private full-document JSON file (default below).
# Leave unset on Vercel. Redis login credentials do not change this local source.
FAMILY_DATA_FILE=""

# Run `npm run setup` for first-time configuration, or auth:configure to change
# an existing shared viewing password.
# Configure separate secrets on your production host.
PASSWORD_HASH=""
SESSION_SECRET=""

# Optional: auth:configure-owner sets a separate password for /edit.
# Leave empty to disable editing without changing viewing access.
OWNER_PASSWORD_HASH=""

# Optional recovery-only JSON string, written by auth:configure.
# The application does not use this value. Keep its contents private.
PASSWORD_RECOVERY=""

# Optional owner recovery-only JSON string, written by auth:configure-owner.
# Keep it private alongside the viewing password recovery metadata.
OWNER_PASSWORD_RECOVERY=""
